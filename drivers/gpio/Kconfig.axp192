config GPIO_AXP192
	bool "AXP192 GPIO driver"
	default y
	depends on DT_HAS_X_POWERS_AXP192_GPIO_ENABLED
	depends on DT_HAS_X_POWERS_AXP192_ENABLED
	select I2C
	select MFD
	help
	  Enable the AXP192 GPIO driver.

config GPIO_AXP192_SYS_INIT_GEN
	bool
	default y
	depends on GPIO_AXP192
	depends on MFD_AXP192_SYS_INIT_GEN
	help
	  Enables generation of a SYS_INIT priority for the AXP192 GPIO driver
	  via subsys/sys_init_gen, based on this symbol's Kconfig dependencies.
	  Must be initialized after the AXP192 MFD driver.
